    do
      local TeletypeClass = request('!.concepts.StreamIo.Teletype')
      local FirmataCompiler =
        request('!.concepts.firmata.compiler.interface')
      local StringStreamClass =
        request('!.mechs.streams.mergeable.string.interface')
      local FirmataParser =
        request('!.concepts.firmata.parser.interface')
      init =
        function(Me, device_file_name)
          local speed_bps = 57600
          Me[1] = TeletypeClass.create(device_file_name)
          local is_ok = Me[1]:Open(speed_bps)
          if not is_ok then
            return
          end
          Me[2] = new(FirmataCompiler)
          Me[2].output = Me[1][4]
          Me[3] = new(StringStreamClass)
          Me[4] = new(FirmataParser)
          Me[4].stream = Me[3]
          Me[2].request.i2c_config(Me[2])
          return true
        end
    end
    local load
    do
      local read_chunk_size = 200
      load =
        function(Me)
          Me[2].request.i2c_read(Me[2], device_id, 0, data_size)
          local data_str = Me[1].Input:Read(read_chunk_size)
          if (data_str == '') then
            return { }
          end
          Me[3]:init(data_str)
          local Records, status = Me[4]:parse()
          for _, Rec in ipairs(Records) do
            if
              (Rec.type == 'i2c_reply') and (Rec.device_id == device_id)
            then
              return Rec.data
            end
          end
          return { }
        end
    end
    local save
    do
      local tbl_unpack = table.unpack
      save =
        function(Me, RawData)
          Me[2].request.i2c_write(
            Me[2], device_id, 0, tbl_unpack(RawData)
          )
        end
    end
    local Interface
    local create
    do
      local attach_methods = request('!.table.attach_methods')
      create =
        function()
          local Me = { }
          attach_methods(Me, Interface)
          return Me
        end
    end
    Interface =
      { create = create, Init = init, Load = load, Save = save }
    return Interface
  end
