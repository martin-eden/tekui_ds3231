package.preload['Widget.CreateApplication'] =
  function(...)
    local TekUi = require('tek.ui')
    do
      local TekUi_Debug = require('tek.lib.debug')
      TekUi_Debug.level = TekUi_Debug.ERROR
    end
    local normalize_file_name =
      request('!.concepts.path_name.normalize')
    local create_window = request('!.frontend.tekui.create_window')
    local special_checkbox_coloring =
      request('Internals.special_checkbox_coloring')
    return
